#!/usr/bin/env bash
# Wrapper to source ESP-IDF environment and run idf.py commands
# Usage: ./idf build | ./idf flash | ./idf monitor | ./idf fresh | etc.
source "$HOME/esp/esp-idf/export.sh" >/dev/null 2>&1

if [ "$1" = "fresh" ]; then
    set -e
    idf.py fullclean
    idf.py build
    idf.py erase-flash
    idf.py flash "${@:2}"
else
    exec idf.py "$@"
fi
