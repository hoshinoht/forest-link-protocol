# FLP Node — Shared defaults (all targets)

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# BLE — NimBLE (smaller footprint than Bluedroid)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=512
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_SIZE=520
CONFIG_BT_NIMBLE_LL_CFG_FEAT_DATA_LEN_EXT=y
CONFIG_BT_NIMBLE_HS_FLOW_CTRL_ITVL=200
CONFIG_BT_NIMBLE_HS_FLOW_CTRL_THRESH=8

# WiFi
CONFIG_ESP_WIFI_MODE_STA=y

# MQTT
CONFIG_MQTT_PROTOCOL_311=y

# Hardware AES acceleration
CONFIG_MBEDTLS_HARDWARE_AES=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
